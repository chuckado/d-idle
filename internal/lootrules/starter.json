{
 "schema": "lootrules/1",
 "name": "Starter",
 "comment": "Today's behaviour as data: ground rules translate internal/loot/pickit_starter.json, pack rules translate internal/tidy/policy.json. docs/lootrules.md section 5.",
 "limits": {
  "maxActions": 12,
  "stashMaxPct": 90
 },
 "defaults": {
  "ground": "ignore",
  "pack": "ignore"
 },
 "rules": [
  {"id":"g-quest","scope":["ground"],"when":{"f":"quest","op":"eq","v":true},"action":"keep","reason":"quest item","tier":"S","prio":100},
  {"id":"g-quest-code","scope":["ground"],"when":{"f":"code","op":"in","v":["j34","g34","d33","g33","bbb","qey","qhr","qbr","qf1","qf2","mss","hfh","ice","tr2","xyz","luv"]},"action":"keep","reason":"act 3-5 quest item","tier":"S","prio":100},
  {"id":"g-unique-charm","scope":["ground"],"when":{"all":[{"f":"group","op":"in","v":["charms"]},{"f":"quality","op":"in","v":["unique"]}]},"action":"stash","reason":"unique charm","tier":"S","prio":95},
  {"id":"g-runes","scope":["ground"],"when":{"f":"group","op":"in","v":["runes"]},"action":"stash","reason":"rune","tier":"S","prio":90},
  {"id":"g-marks","scope":["ground"],"when":{"f":"code","op":"in","v":["mrk"]},"action":"keep","reason":"Raven's Mark currency","tier":"S","prio":92},
  {"id":"g-tomes","scope":["ground"],"when":{"all":[{"f":"code","op":"in","v":["tbk","ibk"]},{"f":"need","op":"eq","v":"tome"}]},"action":"keep","reason":"tome we lack","tier":"S","prio":88},
  {"id":"g-top-gems","scope":["ground"],"when":{"f":"code","op":"in","v":["gzv","gly","glb","glg","glr","glw","gpv","gpy","gpb","gpg","gpr","gpw","skl","skz"]},"action":"stash","reason":"flawless or perfect gem","tier":"S","prio":80},
  {"id":"g-unique-set","scope":["ground"],"when":{"all":[{"f":"quality","op":"in","v":["unique","set"]},{"not":{"f":"group","op":"in","v":["charms"]}}]},"action":"stash","reason":"unique or set item","tier":"A","prio":85},
  {"id":"g-rejuv","scope":["ground"],"when":{"all":[{"f":"type","op":"in","v":["rpot"]},{"f":"need","op":"eq","v":"potion"}]},"action":"keep","reason":"rejuvenation potion the belt needs","tier":"S","prio":65},
  {"id":"g-gold","scope":["ground"],"when":{"all":[{"f":"type","op":"in","v":["gold"]},{"f":"need","op":"eq","v":"gold"}]},"action":"keep","reason":"gold","tier":"S","prio":70},
  {"id":"g-potions","scope":["ground"],"when":{"all":[{"f":"type","op":"in","v":["hpot","mpot"]},{"f":"need","op":"eq","v":"potion"}]},"action":"keep","reason":"potion the belt needs","tier":"S","prio":65},
  {"id":"g-scrolls","scope":["ground"],"when":{"all":[{"f":"code","op":"in","v":["tsc","isc"]},{"f":"need","op":"eq","v":"scroll"}]},"action":"keep","reason":"scroll we use","tier":"S","prio":60},
  {"id":"g-small-charm","scope":["ground"],"when":{"all":[{"f":"type","op":"in","v":["scha"]},{"f":"quality","op":"in","v":["magic","rare"]},{"f":"identified","op":"eq","v":true},{"any":[{"f":"stat:life","op":"ge","v":20},{"f":"stat:fireres","op":"ge","v":5},{"f":"stat:lightres","op":"ge","v":5},{"f":"stat:coldres","op":"ge","v":5},{"f":"stat:poisres","op":"ge","v":5},{"f":"stat:fhr","op":"ge","v":5},{"f":"stat:fcr","op":"ge","v":1},{"f":"stat:mf","op":"ge","v":1},{"f":"stat:allskills","op":"ge","v":1},{"f":"stat:classskills","op":"ge","v":1},{"f":"stat:skilltab","op":"ge","v":1}]}]},"action":"stash","reason":"small charm with life, resist, FCR, FHR, MF or skills","tier":"A","prio":70},
  {"id":"g-big-charm","scope":["ground"],"when":{"all":[{"f":"type","op":"in","v":["mcha","lcha"]},{"f":"quality","op":"in","v":["magic","rare"]},{"f":"identified","op":"eq","v":true},{"f":"need","op":"eq","v":"charmroom"},{"any":[{"f":"stat:life","op":"ge","v":20},{"f":"stat:fireres","op":"ge","v":5},{"f":"stat:lightres","op":"ge","v":5},{"f":"stat:coldres","op":"ge","v":5},{"f":"stat:poisres","op":"ge","v":5},{"f":"stat:fhr","op":"ge","v":5},{"f":"stat:fcr","op":"ge","v":1},{"f":"stat:mf","op":"ge","v":1},{"f":"stat:allskills","op":"ge","v":1},{"f":"stat:classskills","op":"ge","v":1},{"f":"stat:skilltab","op":"ge","v":1}]}]},"action":"stash","reason":"large or grand charm with a kept stat","tier":"A","prio":70},
  {"id":"g-small-charm-id","scope":["ground"],"when":{"all":[{"f":"type","op":"in","v":["scha"]},{"f":"quality","op":"in","v":["magic","rare"]},{"f":"identified","op":"eq","v":false}]},"action":"keep","reason":"unidentified small charm","tier":"A","prio":70,"onUnknown":"match"},
  {"id":"g-big-charm-id","scope":["ground"],"when":{"all":[{"f":"type","op":"in","v":["mcha","lcha"]},{"f":"quality","op":"in","v":["magic","rare"]},{"f":"identified","op":"eq","v":false},{"f":"need","op":"eq","v":"charmroom"}]},"action":"keep","reason":"unidentified large charm","tier":"A","prio":70,"onUnknown":"match"},
  {"id":"g-spare-potions","scope":["ground"],"when":{"f":"group","op":"in","v":["potions"]},"action":"keep","reason":"potion already in the pack","tier":"C","prio":0},
  {"id":"g-spare-scrolls","scope":["ground"],"when":{"f":"group","op":"in","v":["supplies"]},"action":"keep","reason":"town supplies","tier":"C","prio":0},
  {"id":"g-spare-gold","scope":["ground"],"when":{"f":"type","op":"in","v":["gold"]},"action":"keep","reason":"gold pile","tier":"C","prio":0},
  {"id":"g-jewels","scope":["ground"],"when":{"f":"group","op":"in","v":["jewels"]},"action":"stash","reason":"jewel","tier":"A","prio":60},
  {"id":"g-mid-gems","scope":["ground"],"when":{"f":"code","op":"in","v":["gsv","gsy","gsb","gsg","gsr","gsw","sku"]},"action":"stash","reason":"standard grade gem","tier":"A","prio":50},
  {"id":"g-good-jewelry","scope":["ground"],"when":{"all":[{"f":"group","op":"in","v":["jewelry"]},{"f":"quality","op":"in","v":["magic","rare"]},{"f":"identified","op":"eq","v":true},{"any":[{"f":"stat:life","op":"ge","v":20},{"f":"stat:fcr","op":"ge","v":10},{"f":"stat:allskills","op":"ge","v":1},{"f":"stat:fireres","op":"ge","v":15},{"f":"stat:lightres","op":"ge","v":15},{"f":"stat:coldres","op":"ge","v":15},{"f":"stat:poisres","op":"ge","v":15}]}]},"action":"stash","reason":"jewelry with life, FCR, skills or resist","tier":"A","prio":55},
  {"id":"g-jewelry-id","scope":["ground"],"when":{"all":[{"any":[{"f":"group","op":"in","v":["jewelry"]},{"f":"group","op":"in","v":["circlets"]}]},{"f":"quality","op":"in","v":["magic","rare"]},{"f":"identified","op":"eq","v":false}]},"action":"keep","reason":"unidentified jewelry","tier":"A","prio":55,"onUnknown":"match"},
  {"id":"g-rw2","scope":["ground"],"when":{"all":[{"f":"quality","op":"in","v":["normal","superior"]},{"f":"type","op":"in","v":["tors","helm","shld","staf"]},{"f":"need","op":"eq","v":"runeword"},{"f":"sockets","op":"eq","v":2}]},"action":"stash","reason":"2-socket runeword base","tier":"A","prio":40},
  {"id":"g-rw3","scope":["ground"],"when":{"all":[{"f":"quality","op":"in","v":["normal","superior"]},{"f":"type","op":"in","v":["tors","shld"]},{"f":"need","op":"eq","v":"runeword"},{"f":"sockets","op":"eq","v":3}]},"action":"stash","reason":"3-socket runeword base","tier":"A","prio":40},
  {"id":"g-rw4","scope":["ground"],"when":{"all":[{"f":"quality","op":"in","v":["normal","superior"]},{"f":"type","op":"in","v":["tors","helm","shld","weap"]},{"f":"need","op":"eq","v":"runeword"},{"f":"sockets","op":"eq","v":4}]},"action":"stash","reason":"4-socket runeword base","tier":"A","prio":40},
  {"id":"g-keys","scope":["ground"],"when":{"all":[{"f":"code","op":"in","v":["key"]},{"f":"need","op":"eq","v":"key"}]},"action":"keep","reason":"key","tier":"A","prio":20},
  {"id":"g-cube-gems","scope":["ground"],"when":{"all":[{"f":"type","op":"in","v":["gem"]},{"f":"need","op":"eq","v":"gem"}]},"action":"stash","reason":"gem kept for cube upgrades","tier":"A","prio":45},
  {"id":"g-empty-slot","scope":["ground"],"when":{"f":"need","op":"eq","v":"emptyslot"},"action":"keep","reason":"empty weapon or body armor slot","tier":"A","prio":75},
  {"id":"g-poor-gear","scope":["ground"],"when":{"all":[{"f":"gold","op":"lt","v":300},{"f":"group","op":"in","v":["gear"]},{"f":"value","op":"ge","v":20},{"f":"quality","op":"in","v":["low","normal","superior"]}]},"action":"sell","reason":"poor: junk gear sells for gold","tier":"B","prio":3,"pickup":true},
  {"id":"g-low-gems","scope":["ground"],"when":{"f":"type","op":"in","v":["gem"]},"action":"sell","reason":"surplus low gem","tier":"B","prio":10},
  {"id":"g-magic-rare","scope":["ground"],"when":{"f":"quality","op":"in","v":["magic","rare","crafted"]},"action":"sell","reason":"magic or rare item, sells","tier":"B","prio":5},
  {"id":"g-junk","scope":["ground"],"when":{"f":"quality","op":"in","v":["low","normal","superior"]},"action":"drop","reason":"plain or inferior item","tier":"C","prio":0},
  {"id":"amazon-javelins","scope":["pack"],"when":{"f":"group","op":"in","v":["javelins"]},"action":"keep","reason":"throwing weapon of the build","classes":["Amazon"],"name":"javelins"},
  {"id":"t-supplies","scope":["pack"],"when":{"f":"code","op":"in","v":["tbk","ibk","tsc","isc","key"]},"action":"keep","reason":"tome, scroll or key","name":"tomes and scrolls"},
  {"id":"t-potions","scope":["pack"],"when":{"f":"group","op":"in","v":["potions"]},"action":"keep","reason":"potion (the belt and the shop own the count)","name":"potions"},
  {"id":"t-runes","scope":["pack"],"when":{"f":"group","op":"in","v":["runes"]},"action":"stash","reason":"rune","name":"runes"},
  {"id":"t-gems","scope":["pack"],"when":{"f":"group","op":"in","v":["gems"]},"action":"stash","reason":"gem","name":"gems"},
  {"id":"t-charms","scope":["pack"],"when":{"f":"group","op":"in","v":["charms"]},"action":"stash","reason":"charm","name":"charms"},
  {"id":"t-jewels","scope":["pack"],"when":{"f":"group","op":"in","v":["jewels"]},"action":"stash","reason":"jewel","name":"jewels"},
  {"id":"t-unique-set","scope":["pack"],"when":{"f":"quality","op":"in","v":["unique","set"]},"action":"stash","reason":"unique or set item","name":"unique and set"},
  {"id":"t-rare-jewelry","scope":["pack"],"when":{"all":[{"f":"type","op":"in","v":["ring","amul","circ"]},{"f":"quality","op":"in","v":["rare","crafted"]}]},"action":"stash","reason":"rare jewelry or circlet","name":"rare jewelry"},
  {"id":"t-magic-jewelry","scope":["pack"],"when":{"all":[{"f":"type","op":"in","v":["ring","amul"]},{"f":"quality","op":"in","v":["magic"]}]},"action":"stash","reason":"magic jewelry (identify it from the menu)","name":"magic jewelry"},
  {"id":"t-sockets","scope":["pack"],"when":{"all":[{"f":"sockets","op":"ge","v":4},{"f":"quality","op":"in","v":["normal","superior"]}]},"action":"stash","reason":"4+ socket base","name":"socketed bases"},
  {"id":"t-junk","scope":["pack"],"when":{"all":[{"f":"value","op":"lt","v":20},{"f":"packfull","op":"ge","v":85},{"f":"quality","op":"in","v":["low","normal","superior"]}]},"action":"drop","reason":"worth under 20 gold and the pack is full","name":"pure junk"},
  {"id":"t-sell","scope":["pack"],"when":{"f":"value","op":"ge","v":20},"action":"sell","reason":"vendor junk","name":"sellable"}
 ]
}
