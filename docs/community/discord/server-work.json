     "overwrites": [
      {"role": "@everyone", "deny": ["view_channel"]},
      {"role": "member", "allow": ["view_channel", "read_message_history", "send_messages", "send_messages_in_threads", "create_public_threads", "embed_links", "add_reactions"]},
      {"role": "contributor", "allow": ["view_channel", "read_message_history", "send_messages", "send_messages_in_threads", "create_public_threads", "embed_links", "add_reactions", "manage_threads"]}
     ]
    }
   ]
  }
 ]
