  {
   "id": "board.sm.stop-cascades",
   "title": "Stop on scroll also stops read and stones (D2)",
   "kind": "step",
   "tier": "full",
   "quest": {
    "quest": "search_for_cain",
    "chunk": "scroll"
   },
   "step": {
    "action": "interact",
    "target": "Tree of Inifuss",
    "nodes": [
     "wp-dark-wood",
     "to-wood",
     "tree"
    ]
   },
   "covers": [],
   "touches": [
    "internal/questboard/",
    "internal/bot/questboard.go",
    "internal/task/"
   ],
   "pre": {
    "level": 17,
    "gold": 5000,
    "waypoints": [
     1,
     2,
     3
    ],
    "board": {
     "quest": "search_for_cain",
     "chunk": "scroll"
    },
    "board_also": [
     {
      "quest": "search_for_cain",
      "chunk": "read"
     },
     {
      "quest": "search_for_cain",
      "chunk": "stones"
     }
    ]
   },
   "trigger": {
    "goals": "reach:30",
    "knobs": {
     "quests.board": 1,
     "quests.boardSM": 1,
     "resource.pointsDecisions": 1
    },
    "api": [
     {
      "after_s": 60,
      "path": "/api/quests/search_for_cain/cancel",
      "body": {
       "chunk": "scroll",
       "confirm": true
      }
     }
    ]
   },
   "budget": {
    "virtual_min": 30
   },
   "matrix": {
    "classes": [
     "Paladin",
     "Sorceress"
    ],
    "seeds": [
     11,
     3
    ]
   },
   "provenance": "Hero created fresh, clvl 17 by stat verbs, purse 5000, waypoints Cold Plains to Dark Wood, board records as the scenario says. CHEATED: waypoints and level are SETUP writes (mechanics evidence only, never balance).",
   "notes": "D2: Stop implies dependants; the reply lists them in `changed` (field added by card 6).",
   "assert": [
    {
     "kind": "api_reply",
     "index": 0,
     "ok": true,
     "already": false,
     "changed_has": [
      "search_for_cain/read",
      "search_for_cain/stones"
     ]
    },
    {
     "kind": "board",
     "quest": "search_for_cain",
     "chunk": "stones",
     "state": "ready",
     "or": [
      "locked"
     ]
    },
    {
     "kind": "log_line",
     "pattern": "quest board: starting chunk search_for_cain",
     "max": 0,
     "from_min": 3,
     "why": "nothing of the chain starts after the stop"
    },
    {
     "kind": "no_writes"
    }
   ],
   "status": "pending",
   "pending_reason": "RED live 2026-11-21 (docs/probes/boardsm-scenarios-2026-11-21.md): the stop reply has no `changed` field; red until card 6 boardsm-api"
  },
